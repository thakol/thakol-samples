# Copy to .env.local. These are placeholders, never actual credentials.
KEYCLOAK_ISSUER=https://auth.thakol.io/realms/YOUR_REALM
KEYCLOAK_CLIENT_ID=your-confidential-client-id
KEYCLOAK_CLIENT_SECRET=replace-with-your-server-only-client-secret
NEXTAUTH_URL=http://localhost:3000
# Generate locally with openssl rand -base64 32. Never use this placeholder.
NEXTAUTH_SECRET=replace-with-a-random-local-session-secret
