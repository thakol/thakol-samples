# Port and base configurations
BASE_URL=http://localhost:8000

# OIDC client credentials from Thakol Dashboard
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ISSUER=https://auth.thakol.io/realms/YOUR_REALM

# Starlette session encryption key (run `openssl rand -hex 32` or type a long secret)
SESSION_SECRET_KEY=some-highly-confidential-random-string-value-here
