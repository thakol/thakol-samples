# Port configuration
PORT=3003

# Express OIDC configuration
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ISSUER=https://auth.thakol.io/realms/YOUR_REALM
BASE_URL=http://localhost:3003

# Random encryption secret for cookies (must be at least 32 characters)
SESSION_SECRET=a-very-long-random-string-must-be-at-least-32-chars-long
